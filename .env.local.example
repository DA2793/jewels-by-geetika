# Copy to .env.local and fill in real values. Never commit .env.local.
# Vercel needs the same set under Project → Settings → Environment Variables.

# ── Supabase (supabase.com → Project → Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses RLS; used by every /api route. Required for checkout to work.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Razorpay (dashboard.razorpay.com → Account & Settings → API Keys) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret-here
# Dashboard → Webhooks → endpoint https://www.jewelsbygeetika.com/api/razorpay-webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# ── Resend (resend.com → API Keys). Sending domain jewelsbygeetika.com must be verified. ──
RESEND_API_KEY=re_your-api-key-here
